<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox fx:id="rootContainer"
      alignment="CENTER_LEFT"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="de.rachel.app.Login">
  <padding>
    <Insets bottom="20.0" left="20.0" top="20.0" right="20.0"/>
  </padding>

  <Label text="Username" />
  <TextField fx:id="username" promptText="Benutzername" />

  <Label text="Password" style="-fx-margin-bottom: 15px"/>
  <PasswordField fx:id="password" promptText="Passwort" />

  <HBox spacing="10.0">
    <padding>
      <Insets bottom="0" left="0" top="10.0" right="0"/>
    </padding>

    <Button text="Login" onAction="#onLoginClick"/>
    <Button text="Abbrechen" onAction="#onCancelClick"/>
  </HBox>
</VBox>
