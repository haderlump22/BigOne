<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.HBox?>


<HBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="de.rachel.app.MainMenu">
   <children>
      <MenuBar>
        <menus>
          <Menu mnemonicParsing="false" text="Programme">
            <items>
              <MenuItem mnemonicParsing="false" text="Transaktionen" onAction="#openTransaction"/>
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Konten">
            <items>
              <MenuItem mnemonicParsing="false" text="Abschluss" />
                  <MenuItem mnemonicParsing="false" text="Beträge finden" />
                  <MenuItem mnemonicParsing="false" text="Kontostand" />
                  <MenuItem mnemonicParsing="false" text="Import" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Tabellen">
            <items>
              <MenuItem mnemonicParsing="false" text="Monatsausgaben" />
                  <MenuItem mnemonicParsing="false" text="Jahresausgaben" />
            </items>
          </Menu>
            <Menu mnemonicParsing="false" text="Haushaltskonto">
               <items>
                  <MenuItem mnemonicParsing="false" text="Gehaltsgrundlagen" />
                  <MenuItem mnemonicParsing="false" text="Ausgaben" />
                  <MenuItem mnemonicParsing="false" text="Überweisungsbetrag" />
                  <MenuItem mnemonicParsing="false" text="Haushaltsabschluss" />
               </items>
            </Menu>
        </menus>
      </MenuBar>
   </children>
</HBox>
